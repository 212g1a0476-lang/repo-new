{
  "version": 2,
  "buildCommand": "node -e \"console.log('Backend API ready')\"",
  "outputDirectory": ".",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    },
    {
      "src": "/api",
      "dest": "/api/index.js"
    }
  ]
}
